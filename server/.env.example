# Server
PORT=5050
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/portfolio-cms

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email (contact form notifications) - optional, contact form still saves to DB if unset
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Portfolio Contact <noreply@example.com>"
EMAIL_TO=admin@example.com

# GitHub contribution graph embed
GITHUB_CHART_BASE_URL=https://ghchart.rshah.org

# Seed
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
